# Public canonical URL, without a trailing slash. Leave empty until the real domain exists.
NEXT_PUBLIC_SITE_URL=

# RSVP supports "demo" (no persistence) or "endpoint".
NEXT_PUBLIC_RSVP_MODE=demo

# Required only when NEXT_PUBLIC_RSVP_MODE=endpoint. Server-side only.
RSVP_APPS_SCRIPT_URL=
RSVP_SHARED_SECRET=

# Optional Resend email notifications. Google Sheet persistence remains source of truth.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="Maria & Sérgio <rsvp@mariaesergio.com>"
RESEND_REPLY_TO_EMAIL=rsvp@mariaesergio.com
RESEND_ADMIN_EMAILS=

# Required for server-side Pix generation. Do not expose these as NEXT_PUBLIC values.
PIX_KEY=
# Deprecated temporary fallback. Prefer PIX_KEY, especially for EVP random keys.
PIX_KEY_CPF=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=
