# Public canonical URL, without a trailing slash. Leave empty until the real domain exists.
NEXT_PUBLIC_SITE_URL=

# RSVP supports "demo" (no persistence) or "endpoint".
NEXT_PUBLIC_RSVP_MODE=demo

# Required only when NEXT_PUBLIC_RSVP_MODE=endpoint. Server-side only.
RSVP_APPS_SCRIPT_URL=
RSVP_SHARED_SECRET=

# Required for server-side Pix generation. Do not expose these as NEXT_PUBLIC values.
PIX_KEY_CPF=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=
